{
  "family": "lunatalk-task-ec2",
  "networkMode": "bridge",
  "executionRoleArn": "arn:aws:iam::167385253527:role/ecsTaskExecutionRole",
  "requiresCompatibilities": ["EC2"],
  "cpu": "512",
  "memory": "471",
  "containerDefinitions": [
    {
      "name": "lunatalk-container",
      "image": "167385253527.dkr.ecr.ap-northeast-2.amazonaws.com/lunatalk-api@sha256:8655d1c4300a280ff235000ab588d1a0867c1da53021c32b7e1abd1e3196c9ef",
      "cpu": 512,
      "memory": 471,
      "memoryReservation": 471,
      "essential": true,
      "portMappings": [
        {
          "name": "lunatalk-container-8080-tcp",
          "containerPort": 8080,
          "hostPort": 0,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "environment": [
        { "name": "S3_BUCKET", "value": "lunatalk-images" },
        { "name": "AWS_REGION", "value": "ap-northeast-2" },
        { "name": "MAIL_USERNAME", "value": "kkwoncokr@gmail.com" },
        { "name": "MAIL_ADMIN_TO", "value": "kkwondev@gmail.com" },
        { "name": "MAIL_HOST", "value": "smtp.gmail.com" },
        { "name": "TZ", "value": "Asia/Seoul" },
        { "name": "SPRING_PROFILES_ACTIVE", "value": "prod" },
        { "name": "JWT_REFRESH_TOKEN_EXPIRATION_TIME", "value": "604800" },
        { "name": "JWT_ISSUER", "value": "lunatalk" },
        { "name": "DB_NAME", "value": "lunatalk_v2" },
        { "name": "JWT_ACCESS_TOKEN_EXPIRATION_TIME", "value": "7200" },
        { "name": "MAIL_PORT", "value": "587" },
        { "name": "MYSQL_PORT", "value": "3306" },
        { "name": "REDIS_PORT", "value": "6379" }
      ],
      "secrets": [
        {
          "name": "MYSQL_HOST",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:167385253527:secret:lunatalk_secert_key-6zy0Gf:MYSQL_HOST::"
        },
        {
          "name": "MYSQL_USERNAME",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:167385253527:secret:lunatalk_secert_key-6zy0Gf:MYSQL_USERNAME::"
        },
        {
          "name": "MYSQL_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:167385253527:secret:lunatalk_secert_key-6zy0Gf:MYSQL_PASSWORD::"
        },
        {
          "name": "REDIS_HOST",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:167385253527:secret:prod/redis-PkrV9x:REDIS_HOST::"
        },
        {
          "name": "REDIS_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:167385253527:secret:prod/redis-PkrV9x:REDIS_PASSWORD::"
        },
        {
          "name": "JWT_ACCESS_TOKEN_SECRET",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:167385253527:secret:lunatalk_secert_key-6zy0Gf:JWT_ACCESS_TOKEN_SECRET::"
        },
        {
          "name": "JWT_REFRESH_TOKEN_SECRET",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:167385253527:secret:lunatalk_secert_key-6zy0Gf:JWT_REFRESH_TOKEN_SECRET::"
        },
        {
          "name": "TOSS_SECRET_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:167385253527:secret:lunatalk_secert_key-6zy0Gf:TOSS_SECRET_KEY::"
        },
        {
          "name": "MAIL_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:167385253527:secret:prod/mail_password-HoR8B8:MAIL_PASSWORD::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/lunatalk-task-ec2",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
